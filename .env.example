# ── Copia estas variables en Vercel → Project → Settings → Environment Variables (Production, Preview y Development).
# ── Copy these into Vercel → Project → Settings → Environment Variables.
# DATABASE_URL la crea Vercel solo al conectar Neon (Storage). / Vercel sets it when you connect Neon (Storage).
# NUNCA subas un archivo .env real a GitHub / NEVER commit a real .env file.

# URL pública de la app (con https, sin "/" al final) / Public app URL
APP_URL=https://app.tudominio.com

# Base de datos Postgres / Postgres database (cadena de conexión de Neon)
DATABASE_URL=

# Seguridad / Security  (genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Primer usuario del negocio (se crea al primer inicio de sesión) / First business user
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA — formato compatible con OpenAI. Por defecto Groq / OpenAI-compatible, Groq by default
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_DAILY_LIMIT=800

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=
VERIFY_TOKEN=
GRAPH_VERSION=v23.0
# Número público para el botón "Escribir por WhatsApp" (solo dígitos con país) / public number
WHATSAPP_PUBLIC_NUMBER=
